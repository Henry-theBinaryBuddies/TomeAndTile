# Copy to `.env` (git ignores it) and fill in only what you need. Never commit `.env`,
# and never paste its values into an issue, a pull request or a chat.
#
# tt-server reads these from its environment, not from this file. Start it with
# `tools/run-server.ps1` (PowerShell) or `bash tools/run-server.sh`, which load `.env`
# and skip blank lines and empty values (an empty TT_LIVEKIT_* value would stop the
# server at start-up). Write values without quotes: everything after `=` is used as is.
# See crates/server/README.md for each variable.

# Video and voice: set all three or none. From the LiveKit Cloud project settings.
TT_LIVEKIT_URL=
TT_LIVEKIT_API_KEY=
TT_LIVEKIT_API_SECRET=

# Development sign-in (`dev:<user_id>` tokens). 1 to enable. Not security: never on a
# reachable server.
TT_DEV_AUTH=

# Map and token uploads: a directory for stored files, and the public base URL for their
# links (default: the request's Host header).
TT_ASSET_DIR=
TT_PUBLIC_URL=

# Listener and starting state. Defaults: 8788, 127.0.0.1, the pregenerated table.
TT_PORT=
TT_BIND=
TT_SEED=
